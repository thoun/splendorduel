{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ES2022",
      "moduleResolution": "node",
      "lib": ["dom", "esnext"],  
      "sourceMap": false,
      "rootDir": "src",
      "strict": false
    },
    "include": [
        "*.d.ts",
        "src/ts/**/*.d.ts",
        "src/ts/**/*.ts"
    ]
}
